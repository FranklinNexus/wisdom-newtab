{
  "manifest_version": 3,
  "name": "Wisdom New Tab",
  "version": "0.7.0",
  "description": "A calm new tab with search, developer shortcuts, live tech trends, and a focus timer.",
  "homepage_url": "https://github.com/FranklinNexus/wisdom-newtab",
  "icons": {
    "16": "assets/extension/icon16.png",
    "32": "assets/extension/icon32.png",
    "48": "assets/extension/icon48.png",
    "128": "assets/extension/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://hacker-news.firebaseio.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.github.com https://hacker-news.firebaseio.com"
  }
}
